{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "check": "vp check",
    "ready": "vp run -r build && vp check && vp run -r test",
    "prepare": "vp config --no-agent || true"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite-plus": "0.2.1",
    "vitest": "4.1.9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.4"
}
