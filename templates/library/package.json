{
  "name": "@scope/my-lib",
  "version": "0.0.0",
  "description": "A TypeScript library published to npm and JSR",
  "keywords": [],
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "jsr": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "publint": "pnpm run build && publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "jsr": "pkg-to-jsr",
    "prepack": "pnpm run build && pkg-to-jsr",
    "prepare": "vp config --no-agent || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@types/node": "24.10.0",
    "pkg-to-jsr": "1.5.0",
    "publint": "0.3.14",
    "typescript": "5.9.3",
    "vite-plus": "0.2.1",
    "vitest": "4.1.9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.4"
}
