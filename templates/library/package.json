{
  "name": "typescript-library",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@types/node": "24.2.0",
    "turbo": "2.5.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.11.0"
  }
}
