{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // tsdown (vp pack) emits the bundle + declarations; tsc never emits.
    // `declaration` is required to enable `isolatedDeclarations` below; with
    // `noEmit` tsc still validates declarations but writes nothing.
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    // Force explicit types on every export. This is the same discipline JSR
    // enforces at publish time ("no slow types"), and it lets tsdown generate
    // declarations via the fast oxc-transform path instead of full tsc.
    "isolatedDeclarations": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
