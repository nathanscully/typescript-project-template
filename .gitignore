result
result-*
.direnv/

# Node (only if you test templates in-tree)
node_modules/
.pnpm-store/
*.tsbuildinfo

# OS / editors
.DS_Store
*.pem
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Agent scratch
/.agent-shell/
